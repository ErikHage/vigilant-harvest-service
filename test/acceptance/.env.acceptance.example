# Copy to test/acceptance/.env.acceptance and fill in the password.
#
# Both services must already be running, on this machine: the suite refuses any
# other host, because it writes and deletes data.
#
# The suite gets its token the way the app does, by logging in to
# feral-authentication-service. `vigilant-test-gardener` exists only in local
# databases, so a run pointed at a live service fails at login. The README says
# how to create it. Never log in here as a real user.

ACCEPTANCE_BASE_URL=http://localhost:8002/api/vigilant-harvest-service/v0
ACCEPTANCE_AUTH_URL=http://localhost:8003/api/feral-authentication-service/v0
ACCEPTANCE_USERNAME=vigilant-test-gardener
ACCEPTANCE_PASSWORD=

# The application whose scope is `vigilant`, from feral's GET /applications.
# The user needs a grant to it: login is refused with a 403 otherwise.
ACCEPTANCE_APPLICATION_ID=

# Optional: milliseconds before a single HTTP call is aborted.
# ACCEPTANCE_REQUEST_TIMEOUT_MS=10000
