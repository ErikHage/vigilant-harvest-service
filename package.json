{
  "name": "vigilant-harvest-service",
  "version": "0.0.1",
  "description": "Collection of vigilant harvest apis",
  "author": "Erik Hage",
  "scripts": {
    "clean": "rimraf dist/*",
    "tsc": "tsc",
    "build": "npm-run-all clean lint tsc copy-assets",
    "copy-assets": "ts-node tools/copy-assets",
    "postbuild": "",
    "dev:start": "npm-run-all build start",
    "start": "node ./dist/src/server.js",
    "lint": "eslint . --ext .ts",
    "dev": "nodemon --watch src -e ts,ejs --exec npm run dev:start",
    "prepush": "npm run lint",
    "tsc:acceptance": "tsc -p test/acceptance/tsconfig.json",
    "test:acceptance": "vitest run --config test/acceptance/vitest.config.mts",
    "test:acceptance:watch": "vitest --config test/acceptance/vitest.config.mts",
    "tsc:unit": "tsc -p test/unit/tsconfig.json",
    "test:unit": "vitest run --config test/unit/vitest.config.mts"
  },
  "dependencies": {
    "@feral-auth/token-verifier": "0.2.0",
    "@types/db-migrate-base": "^0.0.14",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "db-migrate": "^0.11.14",
    "db-migrate-mysql": "^3.0.0",
    "dotenv": "^16.0.3",
    "express": "^5.2.1",
    "mysql2": "^3.9.7",
    "pino": "^9.1.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.2.0",
    "@feral-auth/ts-simple-dsl": "0.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.17",
    "@types/node": "^24.19.2",
    "@types/shelljs": "^0.8.15",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "concurrently": "^8.0.1",
    "eslint-plugin-filename-rules": "^1.3.1",
    "nodemon": "^3.1.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^3.0.2",
    "shelljs": "^0.8.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^7.8.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
