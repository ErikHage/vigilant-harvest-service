# Copy to .env and fill in the blanks. .env is gitignored: real values never go
# in a commit. The values here are the local ones, where they're not secret.

PORT=8002

DEPLOYMENT_ENVIRONMENT=dev

# local dev db connection details: the service and its migrations both use the RW user
MYSQL_HOST=localhost
MYSQL_RW_USER=vigilant_rw
MYSQL_RW_PASSWORD=
MYSQL_DATABASE=vigilant_harvest

# feral-authentication-service: where to fetch this application's public keys,
# and the application's id there, which each environment's feral generates
FERAL_AUTH_URL=http://localhost:8003/api/feral-authentication-service/v0
FERAL_APPLICATION_ID=

# Optional: the sites whose pages may read the API's answers, separated by commas.
# The default is the dev app and the live site.
# CORS_ORIGINS=http://localhost:5174,https://theferalrooster.com
